  + categoria(): String {override}
  + costo(): BigDecimal {override}
  + diasAtencion(): int {override}
  + limiteVisitas(): int {override}
}
class Instalacion {
  - puntos: int
  --
  + Instalacion(p1: String, p2: String, p3: String, p4: BigDecimal, p5: Zona, p6: int)
  + puntos(): int
  + horasFacturables(): BigDecimal
  + categoria(): String {override}
  + costo(): BigDecimal {override}
  + diasAtencion(): int {override}
  + limiteVisitas(): int {override}
}
class InstalacionCertificada {
