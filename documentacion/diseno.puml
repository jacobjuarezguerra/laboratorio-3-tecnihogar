}
class Sistema {
  - ordenes: Map<String, Orden>
  - cuadrillas: Map<String, Cuadrilla>
  - jornadas: Map<String, Jornada>
  - ingresos: List<Ingreso>
  --
  + Sistema()
  + cotizar(p1: Orden): String
  + registrar(p1: Orden): void
  - agregarOrden(p1: Orden, p2: boolean): void
  + registrarCuadrilla(p1: Cuadrilla): void
  + crearJornada(p1: String, p2: String): void
  + asignar(p1: String, p2: String): void
  + retirar(p1: String, p2: String): void
  + iniciar(p1: String): void
  + resultado(p1: String, p2: String, p3: boolean): void
  + orden(p1: String): Orden
  + cuadrilla(p1: String): Cuadrilla
  + jornada(p1: String): Jornada
  - buscar(p1: Map<String, T>, p2: String, p3: String): <T> T
  + ordenes(): List<Orden>
  + cuadrillas(): List<Cuadrilla>
  + jornadas(): List<Jornada>
  + ingresos(): List<Ingreso>
  + total(p1: String): BigDecimal
