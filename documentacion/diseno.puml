@startuml
skinparam classAttributeIconSize 0
abstract class Orden {
  - codigo: String
  - cliente: String
  - direccion: String
  - horas: BigDecimal
  - zona: Zona
  - estado: EstadoOrden
  - visitas: int
  --
  # Orden(p1: String, p2: String, p3: String, p4: BigDecimal, p5: Zona)
  + categoria(): String {abstract}
  + costo(): BigDecimal {abstract}
  + diasAtencion(): int {abstract}
  + limiteVisitas(): int {abstract}
  + compatible(p1: Cuadrilla): boolean
  + codigo(): String
  + cliente(): String
  + direccion(): String
  + horas(): BigDecimal
  + zona(): Zona
  + estado(): EstadoOrden
  + visitas(): int
  ~ asignar(): void
  ~ retirar(): void
  ~ iniciarVisita(): void
  ~ resultado(p1: boolean): void
  # dinero(p1: BigDecimal): BigDecimal {static}
  + toString(): String {override}
}
class Diagnostico {
  --
